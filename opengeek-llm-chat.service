[Unit]
Description=OpenGeekLLMChat Server (llama.cpp backend)
After=network.target
Wants=network.target

[Service]
Type=simple

# ⚠️ 以下を環境に合わせて変更してください
User=wizapply-ai
Group=wizapply-ai
WorkingDirectory=/home/wizapply-ai/opengeek-llm-chat
ExecStart=/usr/bin/node /home/wizapply-ai/opengeek-llm-chat/server.js

# 再起動設定
# プロセスが終了したら自動的に再起動する。ブラウザUIの「再起動」ボタンや
# クラッシュ時に systemd が自動復活させる。
Restart=always
RestartSec=3

# 環境変数（必要に応じて）
Environment=NODE_ENV=production
Environment=PORT=3000
# matplotlibのキャッシュ先（ProtectHomeで~/.config が書けないため /tmp に）
Environment=MPLCONFIGDIR=/tmp/matplotlib

# AMD ROCm環境では HSA_OVERRIDE_GFX_VERSION 等が必要な場合あり
# Environment=HSA_OVERRIDE_GFX_VERSION=12.0.1
# Environment=HIP_VISIBLE_DEVICES=0,1

# ログ出力
StandardOutput=journal
StandardError=journal

# セキュリティ
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

# 書き込み許可ディレクトリ
# - /home/wizapply-ai/opengeek-llm-chat: chats/ public/uploads/ public/plots/ settings.json 等
# - /tmp: Pythonスクリプト一時ファイル / TTS一時wav (VD_OUT_DIR 既定)
# ⚠️ Irodori-TTS VoiceDesign を使う場合は、HuggingFaceモデルキャッシュ書き込みのため
#    ~/.cache/huggingface も追加する（ProtectHome=read-only だと書けず合成に失敗する）。
#    例: ReadWritePaths=... /tmp /home/wizapply-ai/.cache/huggingface
ReadWritePaths=/home/wizapply-ai/opengeek-llm-chat /tmp /home/wizapply-ai/.cache/huggingface

# llama-server を spawn するためバイナリ実行が必要
# Pythonスクリプト実行も含む
PrivateTmp=false

[Install]
WantedBy=multi-user.target
